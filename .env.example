# SCM-Cert-Bench Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# LLM Gateway - Optional (OpenRouter)
# ============================================================================
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_api_key
OPENROUTER_MODEL=x-ai/grok-4.1-fast
# Recommended by OpenRouter for analytics/ranking (polite headers)
OPENROUTER_HTTP_REFERER=https://github.com/maksim-tsi/agentic-scm-tra26
OPENROUTER_X_TITLE=Agentic-SCM-TRA26

# ============================================================================
# HOME LAB INFRASTRUCTURE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Three-Node Architecture (Post Role Swap - November 2025)
#
# skz-cloud-lv (192.168.redacted.redacted) - Backup/Storage Node
#   Services: MinIO, Nextcloud, Prometheus, Grafana
#
# skz-dev-lv (192.168.redacted.redacted) - Dev & Platform Node
#   Services: n8n, Redis, Phoenix
#
# skz-data-lv (192.168.redacted.redacted) - AI & Data Node
#   Services: PostgreSQL, Qdrant, Neo4j, Typesense
# ============================================================================
# --- NODE IP ADDRESSES ---
CLOUD_NODE_IP=192.168.redacted.redacted  # skz-cloud-lv (Backup/Storage Node)
DEV_NODE_IP=192.168.redacted.redacted    # skz-dev-lv (Dev & Platform Node)
DATA_NODE_IP=192.168.redacted.redacted   # skz-data-lv (AI & Data Node)

# --- SERVICE PORTS ---
# Data Node Services (skz-data-lv)
POSTGRES_PORT=5432
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
TYPESENSE_PORT=8108

# Dev Node Services (skz-dev-lv)
REDIS_PORT=6379
N8N_PORT=5678
PHOENIX_PORT=6006

# Cloud Node Services (skz-cloud-lv)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NEXTCLOUD_PORT=8081
PROMETHEUS_PORT=9099
GRAFANA_PORT=3000

# ============================================================================
# Development Settings
# ============================================================================
# Set to 'development' for testing with Claude 3.5 Haiku
ENVIRONMENT=production

# Enable detailed logging
LOG_LEVEL=INFO
PHOENIX_COLLECTOR_ENDPOINT=http://${DEV_NODE_IP}:6006/v1/traces
PHOENIX_PROJECT_NAME=agentic-scm-tra26

# Enable YAAM API v2
YAAM_SEMANTIC_GATEWAY_URL=http://${DEV_NODE_IP}:8080
# ============================================================================
# Cost Tracking
# ============================================================================
# Enable token usage and cost tracking
TRACK_COSTS=true

# Monthly cost alert threshold (USD)
COST_ALERT_THRESHOLD=150

# Local imports
PYTHONPATH=src:tools
# SCM-MAS Evaluation Framework environment template
#
# Copy to `.env` for local runs. Do not commit `.env` or provider secrets.

# OpenRouter / OpenAI-compatible LLM gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=tencent/hy3-preview
OPENROUTER_HTTP_REFERER=https://github.com/maksim-tsi/agentic-scm-tra26
OPENROUTER_X_TITLE=Agentic-SCM-TRA26

# Optional YAAM REST v2 memory endpoint used by AgenticGraph runs.
# Leave unset if you only run the no-memory native tool-calling path.
YAAM_PROJECT_ID=agentic-scm-tra26
YAAM_SEMANTIC_GATEWAY_URL=http://127.0.0.1:8002

# Optional Phoenix/OpenTelemetry endpoint for local trace collection.
PHOENIX_PROJECT_NAME=agentic-scm-tra26
PHOENIX_BASE_URL=http://127.0.0.1:6006
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_API_KEY=
PHOENIX_CLIENT_HEADERS=

# Runtime behavior.
ENVIRONMENT=production
LOG_LEVEL=INFO
TRACK_COSTS=true
COST_ALERT_THRESHOLD=150
PYTHONPATH=src:tools

"Requirement\",","        \"relevant_entity\": \"Shipping Agent (for Container Vessel)\",","        \"regulation_category\": \"Shipping - Reporting\",","        \"regulation_subcategory\": \"Arrival Pre-Notification\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 8.1.1.1 (Inferred)\",","        \"regulation_detail\": \"Shipping agents for seagoing container vessels must include the following information in the Arrival Pre-notification: (While the Port Instructions detail Berth Request info extensively, specific data for *Pre-Notification* is not explicitly listed in a clear checklist format in the analyzed sections. Further document review might be needed, or we can infer that Pre-Notification is a simpler, initial notification *before* the detailed Berth Request).\",","        \"keywords\": [","            \"shipping agent\",","            \"pre-notification\",","            \"data elements\",","            \"arrival information\",","            \"seagoing container vessels\",","            \"shipping reporting\",","            \"Port of Antwerp\",","            \"requirement\",","            \"inferred\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_TOWAGE_MANDATORY_CONTAINER_VESSEL_DOCKS_045\",","        \"datapoint_type\": \"Regulation\",","        \"relevant_entity\": \"Container Vessel (Sea-going)\",","        \"regulation_category\": \"Towage\",","        \"regulation_subcategory\": \"Mandatory Tug Usage\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 8.6.3\",","        \"regulation_detail\": \"Tug use is mandatory for seagoing vessels, including container vessels, in specific docks: Southern Inlet Dock (all seagoing vessels), Inlet Dock 1 (Jetty 625A - all seagoing vessels), Bevrijdings Dock (vessels \u003e 45m width or over 180m/250m for certain maneuvers).\",","        \"keywords\": [","            \"tug use\",","            \"mandatory\",","            \"seagoing vessels\",","            \"container vessels\",","            \"specific docks\",","            \"Southern Inlet Dock\",","            \"Inlet Dock 1\",","            \"Bevrijdings Dock\",","            \"towage\",","            \"Port of Antwerp\",","            \"regulation\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_PILOTAGE_MANDATORY_LARGE_VESSELS_VISIBILITY_046\",","        \"datapoint_type\": \"Regulation\",","        \"relevant_entity\": \"Sea-going Vessel\",","        \"regulation_category\": \"Pilotage\",","        \"regulation_subcategory\": \"Mandatory Pilotage\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 8.5.1\",","        \"regulation_detail\": \"Pilot assistance is mandatory for seagoing vessels, including large container vessels, at all times if visibility is less than 1000m OR wind force is \\u2265 6 Beaufort (HMO assesses/communicates).\",","        \"keywords\": [","            \"pilotage\",","            \"mandatory\",","            \"seagoing vessels\",","            \"large container vessels\",","            \"visibility \u003c 1000m\",","            \"wind force \\u2265 6 Beaufort\",","            \"HMO\",","            \"Port of Antwerp\",","            \"regulation\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_HAZARDOUS_GOODS_STORAGE_FRONT_QUAY_PACKAGED_MAX_30DAYS_047\",","        \"datapoint_type\": \"Regulation\",","        \"relevant_entity\": \"Hazardous Goods (Packaged, Front Quay Warehouse)\",","        \"regulation_category\": \"Hazardous Goods - Storage\",","        \"regulation_subcategory\": \"Storage Period\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 10.2.1.2\",","        \"regulation_detail\": \"Maximum storage period for *packaged* hazardous goods in front quay transit warehouses at Port of Antwerp is 30 days, non-extendable, except for specific
l required documentation is submitted to customs authorities for containerized goods imported through the Port of Antwerp.\",","        \"keywords\": [","            \"importer\",","            \"customs clearance\",","            \"containerized cargo\",","            \"responsibility\",","            \"documentation\",","            \"customs authorities\",","            \"Port of Antwerp\",","            \"fact\",","            \"general principle\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_CUSTOMS_CLEARANCE_INSPECTION_RISK_050\",","        \"datapoint_type\": \"Fact (General SCM/Customs Risk)\",","        \"relevant_entity\": \"Containerized Cargo (Import)\",","        \"regulation_category\": \"Customs Clearance\",","        \"regulation_subcategory\": \"Risks \u0026 Delays\",","        \"source_document\": \"Port Instructions \u0026 PPR (Implied)\",","        \"source_section\": \"N/A (Implied)\",","        \"regulation_detail\": \"Containerized goods imported through the Port of Antwerp are subject to potential customs inspections, which can lead to delays if documentation is incomplete, inaccurate, or if the cargo is flagged for further scrutiny.\",","        \"keywords\": [","            \"customs inspections\",","            \"containerized goods\",","            \"risks\",","            \"delays\",","            \"documentation\",","            \"incomplete\",","            \"inaccurate\",","            \"scrutiny\",","            \"Port of Antwerp\",","            \"fact\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_HAZARDOUS_GOODS_CONTAINER_DECLARATION_MANDATORY_ENTRY_051\",","        \"datapoint_type\": \"Requirement\",","        \"relevant_entity\": \"Hazardous Goods Shipment (Containerized, IMDG Class X)\",","        \"regulation_category\": \"Hazardous Goods - Declaration\",","        \"regulation_subcategory\": \"Entry Requirement\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 10.1.3 (Inferred)\",","        \"regulation_detail\": \"A Hazardous Goods Declaration is mandatory *before* a container vessel carrying hazardous goods (IMDG Class X) can fully enter the Port of Antwerp, enabling the Harbour Master's Office to assess risks and ensure safe port entry.\",","        \"keywords\": [","            \"hazardous goods declaration\",","            \"container vessel\",","            \"IMDG Class X\",","            \"mandatory\",","            \"entry requirement\",","            \"harbour master's office\",","            \"Port of Antwerp\",","            \"requirement\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_HAZARDOUS_GOODS_CONTAINER_SDS_MANDATORY_HANDLING_052\",","        \"datapoint_type\": \"Requirement\",","        \"relevant_entity\": \"Hazardous Goods Shipment (Containerized, IMDG Class X)\",","        \"regulation_category\": \"Hazardous Goods - Documentation\",","        \"regulation_subcategory\": \"Safety Documentation\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 10.1.2\",","        \"regulation_detail\": \"Safety Data Sheets (SDS) must be readily available for all containerized hazardous goods (IMDG Class X) *before handling and storage* can commence at Port of Antwerp terminals, ensuring safety information is accessible to port personnel and emergency services.\",","        \"keywords\": [","            \"safety data sheets\",","            \"SDS\",","            \"containerized hazardous goods\",","            \"IMDG Class X\",","            \"handling\",","            \"storage\",","            \"Port of Antwerp\",","            \"requirement\",","            \"safety documentation\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_ENVIRONMENT_COMPLIANCE_WASTE_DEPOSIT_MANDATORY_053\",","        \"datapoint_type\": \"Fact\",","        \"relevant_entity\": \"Port Authority (Environmental)\","," 
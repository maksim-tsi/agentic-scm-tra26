IENCY_059\",","        \"datapoint_type\": \"Fact (Inferred Benefit)\",","        \"relevant_entity\": \"Port User/Port Authority (APICS Benefit)\",","        \"regulation_category\": \"Information Systems - APICS\",","        \"regulation_subcategory\": \"Efficiency Benefit\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 8.1.1.1 (Implied)\",","        \"regulation_detail\": \"The 'stay number' generated by APICS upon Pre-Notification acts as a central identifier, linking various subsequent port processes and data submissions (hazardous goods notification, customs, pilotage), contributing to a more streamlined and efficient information flow for all parties involved.\",","        \"keywords\": [","            \"APICS\",","            \"stay number\",","            \"pre-notification\",","            \"central identifier\",","            \"efficiency\",","            \"information flow\",","            \"Port of Antwerp\",","            \"fact\",","            \"inferred benefit\"","        ]","    },","    {","        \"datapoint_id\": \"ANTWERP_DP_SAFETY_REGULATIONS_SCUPPER_PLUGGING_060\",","        \"datapoint_type\": \"Regulation\",","        \"relevant_entity\": \"Tanker/Tank Barge (Hazardous/Polluting)\",","        \"regulation_category\": \"Safety Regulations\",","        \"regulation_subcategory\": \"Pollution Prevention\",","        \"source_document\": \"Port Instructions\",","        \"source_section\": \"Chapter 3.1.1\",","        \"regulation_detail\": \"A key safety regulation at Port of Antwerp mandates that all scuppers on tankers and tank barges (except gas tankers with spindle edges) must be plugged before loading/unloading hazardous/polluting goods to prevent pollution.\",","        \"keywords\": [","            \"safety regulations\",","            \"scupper plugging\",","            \"tankers\",","            \"tank barges\",","            \"hazardous goods\",","            \"polluting goods\",","  
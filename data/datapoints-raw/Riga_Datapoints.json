ation_subcategory\": \"Application Process\",","        \"source_document\": \"ROT General Conditions\",","        \"regulation_detail\": \"CUSTOMER\\u2019s Application: CUSTOMER's request to provide ROT services, sent to ROT at least 5 (five) days before the day of starting the required ROT service.\",","        \"keywords\": [","            \"ROT\",","            \"service application\",","            \"lead time\",","            \"5 days\",","            \"requirement\"","        ]","    },","    {","        \"datapoint_id\": \"ROT_TARIFF_OVERTIME_HOLIDAYS_005\",","        \"datapoint_type\": \"Tariff Value\",","        \"relevant_entity\": \"Customer/ROT Service\",","        \"regulation_category\": \"ROT Tariffs \u0026 Payments\",","        \"regulation_subcategory\": \"Overtime Tariffs\",","        \"source_document\": \"ROT General Conditions\",","        \"regulation_detail\": \"If ROT service is provided on public holidays and holidays specified in the regulatory enactments of the Republic of Latvia \\u2013 2.0 coefficient shall be applied to the ROT Service tariff rates.\",","        \"keywords\": [","            \"ROT\",","            \"tariff\",","            \"overtime\",","            \"public holidays\",","            \"holidays\",","            \"coefficient\",","            \"pricing\"","        ]","    },","    {","        \"datapoint_id\": \"ROT_LIABILITY_LIMIT_CARGO_DAMAGE_006\",","        \"datapoint_type\": \"Liability Exemption\",","        \"relevant_entity\": \"ROT\",","        \"regulation_category\": \"ROT Liability\",","        \"regulation_subcategory\": \"Cargo Liability Limits\",","        \"source_document\": \"ROT General Conditions\",","        \"regulation_detail\": \"ROT\\u2019s maximum liability for the loss of Cargo above the permissible limit of Cargo losses or for damaged Cargo is equal to the value of the Cargo specified in the invoice...but not more than EUR 870.00 per package or unit or EUR 0.25 per gross kilogram of Cargo.
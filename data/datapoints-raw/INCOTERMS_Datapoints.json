 recommended\",","            \"cpt alternative\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_243_Suitability_CIF_Container_NotRecommended_Usable\",","        \"datapoint_type\": \"Guideline\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"CIF\",","        \"regulation_category\": \"Container Suitability\",","        \"regulation_subcategory\": \"Recommendation\",","        \"regulation_detail\": \"While CIF (Cost, Insurance and Freight) can be applied to containerized shipments, CPT or CIP might be more advantageous for most container exports.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"CIF Guidance Note [Source 1, 4]\",","        \"keywords\": [","            \"cif\",","            \"cost insurance freight\",","            \"suitability\",","            \"container\",","            \"not recommended\",","            \"usable\",","            \"cip alternative\",","            \"cpt alternative\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_244_Suitability_DAP_Container_Recommended\",","        \"datapoint_type\": \"Guideline\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"DAP\",","        \"regulation_category\": \"Container Suitability\",","        \"regulation_subcategory\": \"Recommendation\",","        \"regulation_detail\": \"DAP (Delivered At Place) is suitable for all modes of transport, including containerized and multimodal shipments.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"DAP Guidance Note [Source 1]\",","        \"keywords\": [","            \"dap\",","            \"delivered at place\",","            \"suitability\",","            \"container\",","            \"recommended\",","            \"multimodal\",","            \"any mode\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_245_Suitability_DPU_Container_Recommended\",
st cover the buyer's risk of loss or damage during the sea voyage.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"CIF A5 [Source 4]\",","        \"keywords\": [","            \"cif\",","            \"cost insurance freight\",","            \"insurance\",","            \"benefit\",","            \"buyer risk\",","            \"sea voyage\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_257_Insurance_General_OtherTerms_NoSellerObligation\",","        \"datapoint_type\": \"Fact\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"Seller\",","        \"regulation_category\": \"Insurance\",","        \"regulation_subcategory\": \"General\",","        \"regulation_detail\": \"For Incoterms other than CIF and CIP, the seller has no obligation to arrange cargo insurance.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"General Guidance / A5 for other terms\",","        \"keywords\": [","            \"insurance\",","            \"seller\",","            \"obligation\",","            \"no obligation\",","            \"exw\",","            \"fca\",","            \"fas\",","            \"fob\",","            \"cpt\",","            \"cfr\",","            \"dap\",","            \"dpu\",","            \"ddp\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_258_Insurance_General_BuyerMayNeedAdditionalCover\",","        \"datapoint_type\": \"Guideline\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"Buyer\",","        \"regulation_category\": \"Insurance\",","        \"regulation_subcategory\": \"CIF\",","        \"regulation_detail\": \"Buyers using CIF should be aware the minimum cover may be insufficient and might need to arrange additional insurance.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"CIF Guidance Note [Source 31]\",","        \"keywords\": [","            \"cif\",","            \"cost insurance freight\",","            \"insurance\",","            \"buyer\",","            \"additional cover\",","            \"minimum cover\",","            \"icc c\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_259_Issue_EXW_BuyerExportFormalitiesComplexity\",","        \"datapoint_type\": \"Clarification\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"Buyer\",","        \"regulation_category\": \"Challenges\",","        \"regulation_subcategory\": \"EXW\",","        \"regulation_detail\": \"A significant challenge for the buyer under EXW is handling complex export formalities in the seller's country.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"EXW Guidance Note [Source 9]\",","        \"keywords\": [","            \"exw\",","            \"ex works\",","            \"issue\",","            \"challenge\",","            \"buyer\",","            \"export clearance\",","            \"complexity\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_260_Issue_EXW_SellerMayRemainExporterOfRecord\",","        \"datapoint_type\": \"Clarification\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"Seller\",","        \"regulation_category\": \"Challenges\",","        \"regulation_subcategory\": \"EXW\",","        \"regulation_detail\": \"Even if buyer manages export under EXW, the seller might still be legally considered the exporter of record.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"EXW Guidance Note [Source 9]\",","        \"keywords\": [","            \"exw\",","            \"ex works\",","            \"issue\",","            \"challenge\",","            \"seller\",","            \"exporter of record\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_261_Issue_FCA_NamedPlaceDefinitionClarityNeeded\",","
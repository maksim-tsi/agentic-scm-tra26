 \"FOB Guidance Note [Source 15]\",","        \"keywords\": [","            \"fob\",","            \"free on board\",","            \"issue\",","            \"challenge\",","            \"container\",","            \"risk transfer\",","            \"ambiguity\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_266_Issue_CPT_DeliveryPointVsDestinationConfusion\",","        \"datapoint_type\": \"Clarification\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"CPT\",","        \"regulation_category\": \"Challenges\",","        \"regulation_subcategory\": \"CPT\",","        \"regulation_detail\": \"A common point of confusion with CPT is the distinction between the place of delivery (risk transfer) and the named place of destination (cost endpoint).\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"CPT Guidance Note [Source 20]\",","        \"keywords\": [","            \"cpt\",","            \"carriage paid to\",","            \"issue\",","            \"challenge\",","            \"confusion\",","            \"delivery point\",","            \"destination\",","            \"risk transfer\",","            \"cost\"","        ]","    },","    {","        \"datapoint_id\": \"INCO_DP_267_Issue_CIP_BuyerEnsureAdequateInsuranceCoverObtained\",","        \"datapoint_type\": \"Guideline\",","        \"domain_area\": \"Incoterms:2020\",","        \"relevant_entity\": \"Buyer\",","        \"regulation_category\": \"Challenges\",","        \"regulation_subcategory\": \"CIP\",","        \"regulation_detail\": \"Buyers using CIP should ensure the insurance coverage obtained by the seller is adequate for their specific needs, despite the ICC(A) requirement.\",","        \"source_document\": \"Incoterms 2020 Rules\",","        \"source_section\": \"CIP Guidance Note [Source 22]\",","        \"keywords\": [","            \"cip\",","            \"carriage and insurance paid to\",","            \"i